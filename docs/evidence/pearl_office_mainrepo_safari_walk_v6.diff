+  if(k==='shift') return e.location===2?'ShiftRight':'ShiftLeft';
+  if(k==='arrowleft') return 'ArrowLeft'; if(k==='arrowright') return 'ArrowRight';
+  if(k==='arrowup') return 'ArrowUp'; if(k==='arrowdown') return 'ArrowDown';
+  return e.code || '';
